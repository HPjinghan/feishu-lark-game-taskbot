{
  "name": "feishu-game-taskbot",
  "compatibility_date": "2026-05-26",
  "main": "src/index.ts",
  "vars": {
    // Lark/Feishu OpenAPI base URL. Default works for most regions.
    "LARK_API_BASE": "https://open.feishu.cn",
    // Set to "1" to write debug events to KV (for troubleshooting only — costs KV writes).
    "DEBUG_EVENTS": "0",
    // Comma-separated open_ids of admins to alert on critical errors. Leave empty to disable.
    "ADMIN_OPEN_IDS": "",
    // Optional — only used by the auto-scheduler's LLM-assisted steps (task
    // breakdown, duration estimation). Leave LLM_API_KEY unset (don't add it
    // here — put it in `wrangler secret put LLM_API_KEY` instead) to run the
    // bot with zero LLM dependency. "anthropic" | "openai" | "openai-compatible".
    "LLM_PROVIDER": "anthropic",
    // Override only if you're pointing at a non-default region/self-hosted/
    // OpenAI-compatible endpoint (DeepSeek, Moonshot/Kimi, vLLM, etc).
    "LLM_BASE_URL": "",
    "LLM_MODEL": ""
  },
  "kv_namespaces": [
    {
      "binding": "BOT_KV",
      // Replace with your KV namespace ID after running: wrangler kv namespace create BOT_KV
      "id": "REPLACE_WITH_YOUR_KV_NAMESPACE_ID"
    }
  ]
}
